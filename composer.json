{
    "name": "pkdev/reporter",
    "description": "Reports site telemetry (heartbeats, queues, crons, exceptions, deployments) to the PKDev control plane.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "guzzlehttp/guzzle": "^7.0",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/contracts": "^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^11.0|^12.0",
        "mockery/mockery": "^1.6"
    },
    "autoload": {
        "psr-4": {
            "Pkdev\\Reporter\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Pkdev\\Reporter\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Pkdev\\Reporter\\PkdevReporterServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
